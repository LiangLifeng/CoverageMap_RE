params.records = null
params.fna = null
params.fai = null
params.mate_audit = null

process {
    withLabel: 'cram_index' {
        cpus = 1
        errorStrategy = 'terminate'
        publishDir = [
            path: { "${params.outdir}/cram_index" },
            mode: 'copy',
            overwrite: false,
            pattern: '*.sqlite',
            failOnError: true
        ]
    }
}


params.index_chunk_buckets = 4096
params.index_chunk_size = 100
params.index_chunk_cpus = 4
params.index_min_mapq = 0
params.index_m5_policy = 'geometry_only'

process {
    withLabel: 'cram_metrics_chunk' {
        cpus = { params.index_chunk_cpus as int }
        errorStrategy = 'finish'
    }
    withLabel: 'cram_metrics_merge' {
        cpus = 1
        errorStrategy = 'finish'
        publishDir = [
            path: { "${params.outdir}/cram_index" },
            mode: 'copy', overwrite: false,
            pattern: '*.sqlite', failOnError: true
        ]
    }
}
