params.records = null
params.fna = null
params.fai = null

process {
    withLabel: 'cram_index' {
        cpus = 1
        errorStrategy = 'terminate'
        publishDir = [
            path: { "${params.outdir}/cram_index" },
            mode: 'copy',
            overwrite: false,
            pattern: '*.sqlite',
            failOnError: true
        ]
    }
}

