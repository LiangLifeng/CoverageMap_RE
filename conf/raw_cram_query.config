process {
    withName: 'RAW_QUERY_PLAN' {
        cpus = 1
        cache = false
    }
    withName: 'RAW_QUERY_SCORE' {
        cpus = { params.query_cpus.toInteger() }
        memory = { params.query_memory }
        time = { params.query_time }
        errorStrategy = 'ignore'
        publishDir = [path: { "${params.outdir}/queries" }, mode: 'copy', failOnError: true]
    }
    withName: 'RAW_QUERY_DIAGNOSTICS' {
        cpus = { params.diagnostics_cpus.toInteger() }
        errorStrategy = 'ignore'
        publishDir = [path: { params.outdir }, mode: 'copy', failOnError: true]
    }
    withName: 'RAW_QUERY_COLLECT' {
        cpus = 1
        publishDir = [path: { params.outdir }, mode: 'copy', failOnError: true]
    }
}

