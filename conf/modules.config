process {
    withLabel: 'query_control' {
        cpus = 1
        memory = '2 GB'
    }
    withName: 'QUERY_PLAN' {
        cache = false
    }
    withName: 'QUERY_SCORE' {
        cpus = { params.query_cpus.toInteger() }
        memory = { params.query_memory }
        time = { params.query_time }
        // A deterministic input/schema error is not repaired by another try.
        // Failed tasks are excluded from the successful cache; the collector
        // retains missing IDs as execution errors while healthy queries finish.
        errorStrategy = { task.exitStatus in [75, 137, 143] && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries = 1
    }
    withName: 'QUERY_COLLECT' {
        publishDir = [path: { params.outdir }, mode: 'copy', pattern: 'collected', failOnError: true]
    }
    withLabel: 'query_diagnostics' {
        cpus = { params.diagnostics_cpus.toInteger() }
        memory = '4 GB'
        time = '1h'
        errorStrategy = 'ignore'
        publishDir = [path: { params.outdir }, mode: 'copy', pattern: 'diagnostics', failOnError: true]
    }
}
