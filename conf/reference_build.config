params {
    records = null
    references = null
    chunk_size = 100
    cpus_per_chunk = 4
    max_chunks = null // Retired: use executor.queueSize / -qs instead of a chunk maxForks cap.
    memory_per_chunk = '8 GB'
    reference_time = null
    collect_cpus = 2
    plan_cpus = 64
    partition = 'cpu,tai'
    smoke_records = 0
    reference_window_size = 1000
    reference_bin_count = null
}

env {
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    NUMEXPR_NUM_THREADS = '1'
}

process {
    withName: 'REFERENCE_PLAN' {
        cpus = { params.plan_cpus.toInteger() }
    }
    withName: 'REFERENCE_CHUNK' {
        cpus = { params.cpus_per_chunk.toInteger() }
        memory = { params.memory_per_chunk }
        time = { params.reference_time }
        errorStrategy = 'finish'
    }
    withName: 'REFERENCE_COLLECT' {
        cpus = { params.collect_cpus.toInteger() }
    }
    withName: 'REFERENCE_INDEX' {
        cpus = { params.collect_cpus.toInteger() }
        publishDir = [path: { params.outdir }, mode: 'copy', pattern: 'reference_build.json', failOnError: true]
    }
}

profiles {
    slurm {
        process.queue = { params.partition }
        executor.queueSize = 100
    }
    nhb {
        process {
            withName: 'REFERENCE_PLAN' { memory = null; time = null }
            withName: 'REFERENCE_CHUNK' { memory = null; time = null }
            withName: 'REFERENCE_COLLECT' { memory = null; time = null }
            withName: 'REFERENCE_INDEX' { memory = null; time = null }
        }
    }
}
