params {
    manifest = null
    index = null
    fai_map = null
    fai_dir = null
    outdir = 'raw_query_results'
    alpha = null
    reference_draws = 100
    sampling_tolerance_bp = 150
    geometry_cache_dir = null
    seed = 401
    depth_threshold = 5
    bin_count = null
    window_size = null
    sampling_unit = 'read'
    min_mapq = 0
    min_samples = 10
    query_cpus = 4
    jaccard_coverage_threshold = 0
    jaccard_coverage_thresholds = null
    jaccard_methods = 'normal'
    bootstrap_replicates = 1000
    bootstrap_confidence = 0.95
    coverage_alignment_policy = 'primary_only'
    coverage_unit = null
    diagnostics = true
    diagnostics_cpus = 4
    diagnostics_bin_dir = null
    query_memory = null
    query_time = null
    cache_mib = 0
    work_mib = 0
    coverage_conda_env = '/home/lianglifeng/01.WorkDir/env/conda-envs/coverage-map'
}
includeConfig '../conf/raw_cram_query.config'
process.shell = ['/bin/bash', '-euo', 'pipefail']
workflow.failOnIgnore = true
conda.enabled = true
process.conda = { params.coverage_conda_env }
env.PYTHONDONTWRITEBYTECODE = '1'
profiles {
    local { process.executor = 'local' }
    slurm {
        process.executor = 'slurm'
        process.queue = 'cpu,tai'
        executor.queueSize = 100
        process {
            withName: 'RAW_QUERY_SCORE' { memory = null; time = null }
        }
    }
    nhb {
        process {
            withName: 'RAW_QUERY_SCORE' { memory = null; time = null }
        }
    }
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyyMMdd_HHmmss_SSS')}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${new Date().format('yyyyMMdd_HHmmss_SSS')}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyyMMdd_HHmmss_SSS')}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag_${new Date().format('yyyyMMdd_HHmmss_SSS')}.html"
}
manifest {
    name = 'CoverageMap Raw CRAM Query'
    nextflowVersion = '>=26.04.0'
    version = '1.1.0'
}

