params {
    manifest = null
    index = null
    outdir = 'results'
    alpha = null
    jaccard_coverage_threshold = 0
    jaccard_coverage_thresholds = null
    jaccard_methods = 'normal'
    reference_draws = 100
    bootstrap_replicates = 1000
    bootstrap_confidence = 0.95
    window_size = null
    bin_count = null
    sampling_unit = null
    coverage_alignment_policy = null
    coverage_unit = null
    min_samples = 10
    depth_threshold = 5
    seed = 401
    diagnostics = true
    diagnostics_cpus = 4
    diagnostics_bin_dir = null
    query_cpus = 4
    query_memory = '8 GB'
    query_time = '2h'
    cache_mib = 1024
    work_mib = 4096
    coverage_conda_env = '/home/lianglifeng/01.WorkDir/env/conda-envs/coverage-map'
}

includeConfig 'conf/modules.config'
includeConfig 'conf/cram_index.config'
includeConfig 'conf/reference_build.config'

process.shell = ['/bin/bash', '-euo', 'pipefail']
// Finish independent queries and publish the partial ledger, then report failure
// to launchers when any task (including optional diagnostics) failed.
workflow.failOnIgnore = true
conda.enabled = true
process.conda = { params.coverage_conda_env }
env.PYTHONDONTWRITEBYTECODE = '1'

profiles {
    local { process.executor = 'local' }
    slurm {
        process.executor = 'slurm'
        process.queue = 'cpu,tai'
    }
    nhb {
        process {
            withLabel: 'query_control' { memory = null }
            withName: 'QUERY_SCORE' { memory = null; time = null }
            withLabel: 'query_diagnostics' { memory = null; time = null }
        }
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyy-MM-dd_HH-mm-ss-SSS')}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${new Date().format('yyyy-MM-dd_HH-mm-ss-SSS')}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyy-MM-dd_HH-mm-ss-SSS')}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag_${new Date().format('yyyy-MM-dd_HH-mm-ss-SSS')}.html"
}

manifest {
    name = 'CoverageMap Query'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version = '2.3.0'
}
