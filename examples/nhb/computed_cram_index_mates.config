// The final merge checks every input identity has metrics or an explicit exclusion.
workflow.failOnIgnore = false
process {
    withName: 'CRAM_INDEX_BUILD:CRAM_METRICS_CHUNK' {
        errorStrategy = 'ignore'
        scratch = '/disk'
    }
    withLabel: 'cram_metrics_recover' { scratch = '/disk' }
    withLabel: 'cram_metrics_mate_merge' { scratch = '/disk' }
}
env.TMPDIR = '/disk'
