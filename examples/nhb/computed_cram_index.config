// Native Slurm queue/concurrency are set by the launcher and -qs.
// Explicit /disk scratch avoids the small root /tmp filesystem on NHB.
process {
    withLabel: 'cram_metrics_control' { scratch = '/disk' }
    withLabel: 'cram_metrics_chunk' { scratch = '/disk' }
    withLabel: 'cram_metrics_merge' { scratch = '/disk' }
}
env.TMPDIR = '/disk'
